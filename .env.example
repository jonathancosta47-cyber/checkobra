# Copie para .env e preencha com os dados do SEU projeto Supabase
# (Supabase > Project Settings > API).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO

# Usadas no servidor (SSR). Normalmente os mesmos valores de cima.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=SEU-PROJETO

# Opcional, apenas no servidor — nunca prefixe com VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
